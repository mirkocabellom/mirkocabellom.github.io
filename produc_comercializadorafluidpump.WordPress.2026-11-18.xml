		<title><![CDATA[BOMBA CENTRÍFUGA REGGIO STM 200 T 2HP 380V 1 1/4" x 1"]]></title>
		<link>https://fluidpump.cl/tienda/bombas-hidraulicas/bombas-centrifugas/bomba-centrifuga-reggio-stm-200-t-2-hp-380v/</link>
		<pubDate>Tue, 28 Dec 2021 12:18:17 +0000</pubDate>
		<dc:creator><![CDATA[Marcos]]></dc:creator>
		<guid isPermaLink="false">https://fluidpump.cl/?post_type=product&#038;p=1319</guid>
		<description></description>
		<content:encoded><![CDATA[]]></content:encoded>
